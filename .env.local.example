# Local development: copy to .env.local and run `pnpm start:dev`.
# DATABASE_URL points at the Docker Compose PostgreSQL (`docker compose up -d postgres`).
PORT=3000
HN_URL=https://news.ycombinator.com/
FETCH_TIMEOUT_MS=5000
CACHE_TTL_MS=60000
DATABASE_URL=postgresql://crawler:crawler@localhost:5432/hn_crawler
